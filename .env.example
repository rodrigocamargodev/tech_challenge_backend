# ============================================================
# Blog de Giz - Backend (exemplo de configuração)
# Copie este arquivo para .env e ajuste os valores.
# NUNCA versione o arquivo .env real.
# ============================================================

# Ambiente: development | test | production
NODE_ENV=development

# Porta HTTP da API
PORT=3000

# String de conexão do MongoDB
# Local:  mongodb://localhost:27017/tech_challenge_blog
# Docker: mongodb://mongodb:27017/tech_challenge_blog
MONGO_URI=mongodb://localhost:27017/tech_challenge_blog

# Segredo do JWT (OBRIGATÓRIO).
# Gere um valor forte, por exemplo: openssl rand -hex 32
JWT_SECRET=troque-este-valor-por-um-segredo-forte

# Expiração do token de acesso
JWT_EXPIRES_IN=8h

# Custo do bcrypt (12 é o recomendado para produção)
BCRYPT_SALT_ROUNDS=12

# Origens permitidas no CORS. Use * em desenvolvimento
# ou uma lista separada por vírgulas em produção.
CORS_ORIGIN=*

# ============================================================
# Seed do primeiro professor (usado apenas por `npm run seed:professor`)
# ============================================================
SEED_PROFESSOR_NOME=Professor Administrador
SEED_PROFESSOR_EMAIL=professor@escola.com
SEED_PROFESSOR_SENHA=troque-esta-senha

# ============================================================
# Seed de demonstração (usado por `npm run seed:demo`)
# Exclusivo para desenvolvimento/avaliação local. NUNCA use em produção.
# Se deixadas em branco, são usados os valores padrão de demonstração
# documentados no README.
# ============================================================
DEMO_PROFESSOR_NOME=Professor Demonstração
DEMO_PROFESSOR_EMAIL=professor.demo@blogdegiz.local
DEMO_PROFESSOR_PASSWORD=DemoProfessor123

DEMO_ALUNO_NOME=Aluno Demonstração
DEMO_ALUNO_EMAIL=aluno.demo@blogdegiz.local
DEMO_ALUNO_PASSWORD=DemoAluno123

# Permite (conscientemente) rodar o seed de demonstração contra um host
# MongoDB não local. Mantenha false/ausente no uso normal.
SEED_DEMO_PERMITIR_REMOTO=false
